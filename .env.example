# SuperWomen Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://superwomen:superwomen123@localhost:5432/superwomen_db

# Redis Cache & Pub/Sub
REDIS_URL=redis://localhost:6379

# Geolocation & Maps Providers
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Telephony & Masked Calling (Twilio / Exotel)
TELEPHONY_ACCOUNT_SID=your_telephony_sid
TELEPHONY_AUTH_TOKEN=your_telephony_token
TELEPHONY_VIRTUAL_NUMBER=+918000000000

# Emergency 112 PCR Webhook
POLICE_PCR_WEBHOOK_URL=https://emergency.tnpolice.gov.in/api/v1/sos-ingest
POLICE_PCR_API_KEY=your_pcr_api_key

# Payment Gateways (UPI / Razorpay / Cashfree)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
