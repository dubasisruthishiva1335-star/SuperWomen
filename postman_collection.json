{
  "info": {
    "name": "SuperWomen Mobility Platform API",
    "description": "Complete Postman collection for SuperWomen Captain, Rider, and Admin endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send Phone OTP (497280)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"role\": \"CAPTAIN\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/send-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Phone OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"497280\",\n  \"role\": \"CAPTAIN\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/verify-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Rides & Matching",
      "item": [
        {
          "name": "Request Ride (Rider)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"riderName\": \"Priya\",\n  \"pickup\": \"Koramangala 80ft Rd\",\n  \"drop\": \"Indiranagar Metro Station\",\n  \"vehicleType\": \"SUPER_BIKE\",\n  \"fare\": 185\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/trips/request",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "trips", "request"]
            }
          }
        },
        {
          "name": "Accept Ride (Captain within 18s)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"captainId\": \"cap_priya\",\n  \"captainName\": \"Priya Sharma\",\n  \"vehiclePlate\": \"KA01 AB 4972\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/rides/trip_12345/accept",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "rides", "trip_12345", "accept"]
            }
          }
        },
        {
          "name": "Verify 4-digit OTP & Start Ride",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otpEntered\": \"4972\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/rides/trip_12345/start",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "rides", "trip_12345", "start"]
            }
          }
        }
      ]
    },
    {
