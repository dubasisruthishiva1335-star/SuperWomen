              "raw": "{\n  \"caller\": \"Captain Priya Sharma\",\n  \"role\": \"CAPTAIN\",\n  \"location\": {\n    \"lat\": 12.9352,\n    \"lng\": 77.6245,\n    \"address\": \"Koramangala 80ft Rd\"\n  }\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/safety/sos",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "safety", "sos"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Captains & Wallet",
      "item": [
        {
          "name": "Toggle Online / Offline",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "http://localhost:3000/api/captains/toggle-online",
              "protocol": "http",
